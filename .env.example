# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real keys.

# CoinAPI key, used by the CoinAPI downloader under DataDownload/.
# Get one at https://www.coinapi.io/
# Read by DataDownload/coinapi_downloader.py and DataDownload/data_manager.py.
COINAPI_API_KEY=your-coinapi-key-here

# Binance API credentials are NOT read from the environment.
# live_trading.py prompts for them interactively at run time
# (see setup_live_trading() in live_trading.py).
