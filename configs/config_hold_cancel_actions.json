    "linear_drawdown_multiplier": 2.0,
    "critical_equity_threshold": 0.05,
    "severe_equity_threshold": 0.1,
    "major_equity_threshold": 0.2,
    "moderate_equity_threshold": 0.3,
    "minor_equity_threshold": 0.5,
    "critical_equity_penalty": 5.0,
    "severe_equity_penalty": 3.0,
    "major_equity_penalty": 2.0,
    "moderate_equity_penalty": 1.0,
