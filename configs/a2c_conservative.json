{
  "name": "A2C Conservative Training",
  "description": "Stable A2C configuration with conservative settings",
  "data_file": "data/BTC_SYNTHETIC_MIXED_15m_2024-01-01_to_2024-12-31.csv",
  "model_architecture": "cnn_lstm",
  "algorithm": "a2c",
  "training_params": {
    "total_timesteps": 1000000,
    "max_leverage": 15.0,
    "initial_equity": 10000.0,
    "window_size": 60,
    "stop_loss_pct": 0.015,
    "take_profit_pct": 0.03,
    "maintenance_margin_rate": 0.004,
    "liquidation_fee_rate": 0.005,
    "n_envs": 4
  },
  "hyperparameters": {
    "learning_rate": 1e-4,
    "batch_size": 32,
    "n_steps": 8,
    "gamma": 0.99,
    "gae_lambda": 0.98,
    "ent_coef": 0.01,
    "use_normalization": true,
    "norm_obs": true,
    "norm_reward": true,
    "clip_obs": 10.0,
    "clip_reward": 10.0
  },
  "use_case": "Conservative trading strategy with lower risk"
}
