{
  "config_metadata": {
    "name": "Hold and Cancel Actions Configuration",
    "description": "Enhanced action space with explicit HOLD, BUY, SELL, and CANCEL actions to encourage patience and better risk management",
    "created_date": "2025-07-13",
    "version": "1.0",
    "author": "TensorTrade Enhanced",
    "tags": ["advanced_actions", "hold_cancel", "risk_management"]
  },
  "model_config": {
