{
  "name": "PPO Quick Start - 15min Training",
  "description": "Fast training configuration for quick testing and development",
  "data_file": "data/BTC_SYNTHETIC_MIXED_15m_2024-01-01_to_2024-12-31.csv",
  "model_architecture": "attention_cnn_lstm",
  "algorithm": "ppo",
  "training_params": {
    "total_timesteps": 50000,
    "max_leverage": 25.0,
    "initial_equity": 10000.0,
    "window_size": 60,
    "stop_loss_pct": 0.02,
    "take_profit_pct": 0.04,
    "maintenance_margin_rate": 0.004,
    "liquidation_fee_rate": 0.005,
    "n_envs": 4
  },
  "hyperparameters": {
    "learning_rate": 3e-4,
    "batch_size": 64,
    "n_steps": 1024,
    "n_epochs": 5,
    "clip_range": 0.2,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "use_normalization": true,
    "norm_obs": true,
    "norm_reward": true,
    "clip_obs": 10.0,
    "clip_reward": 10.0
  },
  "use_case": "Quick development and testing"
}
