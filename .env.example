# Copy this file to .env in the repository root and fill in your own values.
# .env is git-ignored; never commit real keys.
#
# DataDownload/coinapi_downloader.py and DataDownload/data_manager.py call
# load_dotenv() when they are imported, so a .env here is picked up whichever
# directory you run from. Exporting the variable in your shell works too, and
# an exported value takes precedence over the one in .env.

# CoinAPI key, used by the CoinAPI downloader under DataDownload/.
# Get one at https://www.coinapi.io/
COINAPI_API_KEY=your-coinapi-key-here

# Binance API credentials are NOT read from the environment.
# live_trading.py prompts for them interactively at run time
# (see setup_live_trading() in live_trading.py).
