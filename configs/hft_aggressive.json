{
  "name": "High Frequency Trading",
  "description": "Optimized for high-frequency trading with quick decisions",
  "data_file": "data/BTC_SYNTHETIC_MIXED_15m_2024-01-01_to_2024-12-31.csv",
  "model_architecture": "attention_cnn_lstm",
  "algorithm": "ppo",
  "training_params": {
    "total_timesteps": 3000000,
    "max_leverage": 15.0,
    "initial_equity": 10000.0,
    "window_size": 30,
    "stop_loss_pct": 0.01,
    "take_profit_pct": 0.02,
    "maintenance_margin_rate": 0.004,
    "liquidation_fee_rate": 0.005,
    "n_envs": 8,
    "train_ratio": 0.8
  },
  "hyperparameters": {
    "learning_rate": 5e-4,
    "batch_size": 256,
    "n_steps": 512,
    "n_epochs": 15,
    "clip_range": 0.3,
    "gamma": 0.95,
    "gae_lambda": 0.9,
    "use_normalization": true,
    "norm_obs": true,
    "norm_reward": true,
    "clip_obs": 10.0,
    "clip_reward": 10.0
  },
  "use_case": "High-frequency trading with quick position changes"
}
