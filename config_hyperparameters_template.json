{
  "description": "Template for trading bot hyperparameter configuration",
  "version": "2.0",
  "data_file": "data/BTC_SYNTHETIC_MIXED_15m_2024-01-01_to_2024-12-31.csv",
  "model_architecture": "attention_cnn_lstm",
  "algorithm": "ppo",
  "training_params": {
    "total_timesteps": 1000000,
    "max_leverage": 25.0,
    "initial_equity": 10000.0,
    "window_size": 60,
    "stop_loss_pct": 0.02,
    "take_profit_pct": 0.04,
    "maintenance_margin_rate": 0.004,
    "liquidation_fee_rate": 0.005,
    "n_envs": 4
  },
  "hyperparameters": {
    "ppo": {
      "learning_rate": 3e-4,
      "batch_size": 64,
      "n_steps": 2048,
      "n_epochs": 10,
      "clip_range": 0.2,
      "gamma": 0.99,
      "gae_lambda": 0.95,
      "use_normalization": true,
      "norm_obs": true,
      "norm_reward": true,
      "clip_obs": 10.0,
      "clip_reward": 10.0
    },
    "a2c": {
      "learning_rate": 7e-4,
      "batch_size": 32,
      "n_steps": 5,
      "gamma": 0.99,
      "gae_lambda": 1.0,
      "ent_coef": 0.0,
      "use_normalization": true,
      "norm_obs": true,
      "norm_reward": true,
      "clip_obs": 10.0,
      "clip_reward": 10.0
    },
    "sac": {
      "learning_rate": 3e-4,
      "batch_size": 256,
      "buffer_size": 1000000,
      "train_freq": 1,
      "gradient_steps": 1,
      "tau": 0.005,
      "gamma": 0.99,
      "use_normalization": true,
      "norm_obs": true,
      "norm_reward": false,
      "clip_obs": 10.0,
      "clip_reward": 10.0
    }
  },
  "recommended_settings": {
    "conservative": {
      "description": "Safe settings for stable training",
      "ppo": {
        "learning_rate": 1e-4,
        "clip_range": 0.1,
        "n_epochs": 4
      }
    },
    "aggressive": {
      "description": "Faster learning with higher risk",
      "ppo": {
        "learning_rate": 1e-3,
        "clip_range": 0.3,
        "n_epochs": 20
      }
    },
    "experimental": {
      "description": "Experimental settings for research",
      "ppo": {
        "learning_rate": 5e-4,
        "clip_range": 0.25,
        "n_epochs": 15,
        "gae_lambda": 0.98
      }
    }
  },
  "tips": {
    "learning_rate": "Lower values (1e-5 to 1e-4) for stable learning, higher (1e-3) for faster convergence",
    "batch_size": "Larger batches (128-256) for more stable gradients, smaller (32-64) for faster updates",
    "normalization": "Highly recommended for stable training, especially with diverse market conditions",
    "clip_range": "PPO specific - lower values (0.1) for conservative updates, higher (0.3) for larger policy changes",
    "gamma": "Discount factor - higher values (0.99) consider long-term rewards, lower (0.95) focus on immediate rewards"
  }
}
